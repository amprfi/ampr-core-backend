module messaging {

  type Message {
      required role: str; # "user" or "assistant"
      required channel: str; #"application", "sms", "whatsapp", or "email"
      required content: str;
      required chat: Chat;
      created_at: datetime {
          default := datetime_current();
      };

      required is_archived : bool {
          default := false
      };

      index on ((.chat, .created_at));

  }

  type Chat {
    required owner: accessControl::User;
    required created_at: datetime {
        default := datetime_current();
    };

    # All messages including archived ones
    multi messages := .<chat[is Message];

    # Recent messages (not archived)
    multi recent_messages := (
        select .messages
        filter not .is_archived
        order by .created_at desc
    );

    # Earlier messages (archived)
    multi archived_messages := (
        select .messages
        filter .is_archived
        order by .created_at desc
    );
  }
}
