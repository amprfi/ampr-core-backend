module messaging {

  scalar type MessageStatus extending enum<Current, PendingSummary, Archived>;

  type Message {
      required role: str; # "user" or "assistant"
      required channel: str; #"application", "sms", "whatsapp", or "email"
      required content: str;
      required chat: Chat;
      created_at: datetime {
          default := datetime_current();
      };

      required status: MessageStatus {
          default := MessageStatus.Current;
      };

      index on ((.chat, .created_at));
  }

  type Summary {
      required content: str;
      required range_start: datetime;
      required range_end: datetime;
      required chat: Chat;
      
      created_at: datetime {
          default := datetime_current();
      };
      
      index on ((.chat, .created_at));
  }

  type Chat {
    required owner: accessControl::User;
    required created_at: datetime {
        default := datetime_current();
    };

    # All messages including archived ones
    multi messages := .<chat[is Message];
    
    # All summaries
    multi summaries := .<chat[is Summary];

    # Recent messages (Current status)
    multi recent_messages := (
        select .messages
        filter .status = MessageStatus.Current
    );

    # Pending Summary messages
    multi pending_messages := (
        select .messages
        filter .status = MessageStatus.PendingSummary
    );

    # Archived messages
    multi archived_messages := (
        select .messages
        filter .status = MessageStatus.Archived
    );
  }
}
