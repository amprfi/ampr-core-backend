module userProfile {

    scalar type InvestmentHorizon extending enum<"1-5", "6-10", "10-20", "20plus">;
    scalar type AgeGroup extending enum<"under25", "25-34", "35-44", "45-54", "55plus">;
    scalar type InvestmentKnowledge extending enum<"novice", "intermediate", "advanced">;
    scalar type RiskAppetite extending int16 {
        constraint min_value(1);
        constraint max_value(5);
    };

    type Profile {
        required user: accessControl::User;
        required country: str;
        required kyc_passed: bool {
            default := false;
        }
        age_group: AgeGroup;
        # stated properties
        stated_investment_horizon: InvestmentHorizon;
        stated_risk_appetite: RiskAppetite;
        stated_investment_knowledge: InvestmentKnowledge;
        multi stated_financial_goals: str;
        multi other_investments: str;

        # inferred properties
        inferred_investment_horizon: InvestmentHorizon;
        inferred_risk_appetite: RiskAppetite;
        inferred_investment_knowledge: InvestmentKnowledge;
        multi inferred_financial_goals: str;

        inferred_investment_thesis: str;
    };

    type WatchList {
        required user: accessControl::User;
        multi assets: assets::asset {
            is_inferred: bool
        };
    };
}