define

  # Attributes
  attribute first-name, value string;
  attribute last-name, value string;
  attribute country, value string;
  attribute email, value string;
  attribute phone, value string;
  attribute stytch-user-id, value string;
  attribute created-at, value datetime;
  attribute updated-at, value datetime;

  # Entities
  entity user,
    owns first-name,
    owns last-name,
    owns country,
    owns email @key,
    owns phone @key,
    owns stytch-user-id @key,
    owns created-at,
    owns updated-at;

